[Unit]
Description=USB/IP server daemon (usbipd)
Documentation=man:usbipd(8)
# usbipd needs the usbip-host stub driver to export local USB devices.
After=network-online.target
Wants=network-online.target
ConditionPathExists=/userdata/software/linux/tools/usb/usbipd

[Service]
Type=simple
# Load the kernel modules first; usbipd cannot export anything without the stub.
ExecStartPre=-/sbin/modprobe usbip-core
ExecStartPre=-/sbin/modprobe usbip-host
# Hand back exports left in SDEV_ST_USED by a client that never closed its
# session, otherwise they stay invisible to "usbip list -r" forever.
ExecStartPre=-/userdata/software/usbip/usbip-recover
# Foreground mode (no -D): usbipd listens on TCP 3240 and logs to stderr.
ExecStart=/userdata/software/linux/tools/usb/usbipd --tcp-port 3241
# A restart must start from a clean slate: release every export on stop.
ExecStopPost=-/userdata/software/usbip/usbip-recover --force
# sysfs access for bind/unbind requires root.
User=root
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
